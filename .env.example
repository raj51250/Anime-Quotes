# Optional. Only needed for the "Trending" (most-favorited) tab.
# Without these set, the app works exactly as before — Trending will
# just show a short setup note instead of a leaderboard.
#
# 1. Create a free project at https://supabase.com
# 2. Run supabase/schema.sql in its SQL editor
# 3. Project Settings -> API -> copy the URL and "anon public" key below
# 4. Rename this file to .env (or .env.local) and restart `npm run dev`

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
